# ============================================================
# Dockerfile.web — Next.js Frontend (multi-platform: amd64 + arm64)
# ============================================================
# Build:  docker build -f Dockerfile.web -t apnagreenbasket-web .
# Run:    docker run -p 3000:3000 apnagreenbasket-web
# ============================================================

# --------------- Stage 1: Install dependencies ---------------
FROM node:22-slim AS deps
WORKDIR /app

# Copy package files
COPY frontend/package.json ./frontend/

# Install dependencies inside frontend folder
WORKDIR /app/frontend
RUN npm install

# --------------- Stage 2: Build the app ----------------------
FROM node:22-slim AS builder
WORKDIR /app

# Backend URL — baked into client-side JS at build time
ARG NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV STANDALONE_BUILD=1

# Copy node_modules from deps stage
COPY --from=deps /app/frontend/node_modules ./frontend/node_modules

# Copy all source code
COPY frontend ./frontend

# Build Next.js app
WORKDIR /app/frontend
RUN npm run build

# --------------- Stage 3: Production runner ------------------
FROM node:22-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy the standalone server (includes only required node_modules)
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/standalone ./

# Copy static assets (not included in standalone by design)
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/static ./.next/static

# Copy public folder (favicon, images, etc.)
COPY --from=builder --chown=nextjs:nodejs /app/frontend/public ./public

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
