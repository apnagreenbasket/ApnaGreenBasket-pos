# =============================================================================
# ApnaGreen Basket — Environment Variables
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/menu_saas
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/menu_saas_test

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth / JWT ----
JWT_SECRET_KEY=CHANGE-ME-generate-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Superadmin Initial Credentials ----
SUPERADMIN_EMAIL=official@apnagreenbasket.com
SUPERADMIN_PASSWORD=ChangeMeToAStrongPassword123!

# --- Admin DashBoard ---
DASHBOARD_RESET_TIME=00:00

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Cloudinary Object Storage ----
CLOUDINARY_CLOUD_NAME=qugwmggq
CLOUDINARY_API_KEY=2137392227xdwef
CLOUDINARY_API_SECRET=your_api_secret_here
# Alternatively: CLOUDINARY_URL=cloudinary://213739222754349:your_api_secret_here@qugwmggq

# ---- App ----
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

FRONTEND_URL=http://localhost:3000

# ---- AWS S3 Database Backups (Optional) ----
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=ap-south-1

# ---- Runtime Mode ----
# "cloud" = deployed cloud server (sync endpoints mounted)
# "local" = desktop terminal local backend (sync endpoints NOT mounted)
RUNTIME_MODE=cloud
CLOUD_BACKEND_URL=http://localhost:8000
LOCAL_OUTLET_ID=

# ---- Alerts & Notifications (Email, WhatsApp, SMS) ----
# Resend Email (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=ApnaGreen Basket <alerts@apnagreenbasket.com>

# Twilio (WhatsApp & SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_SMS_FROM=+1xxxxxxxxxx

# Alternative: Meta WhatsApp Cloud API
META_WHATSAPP_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxx
META_WHATSAPP_PHONE_ID=10xxxxxxxxxxxxx

# Alternative Indian SMS: Fast2SMS (https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Alternative Indian SMS: MSG91 (https://msg91.com)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=AGBMRK
MSG91_TEMPLATE_ID=

