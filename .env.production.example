# =============================================================================
# ApnaGreen Basket — Production Environment Variables Template
# =============================================================================
# Copy this file to .env on your production EC2 server:
#   cp .env.production.example .env
# Fill in real credentials. NEVER commit .env to Git.
# =============================================================================

# ---- App Environment ----
APP_ENV=production
DEBUG=false
ALLOWED_ORIGINS=https://app.apnagreenbasket.com,https://pos.apnagreenbasket.com
LOG_LEVEL=INFO

# ---- Database (AWS RDS PostgreSQL with Strict SSL) ----
# Note: sslmode=verify-full ensures connection encrypts and validates RDS CA certificate
DATABASE_URL=postgresql+asyncpg://postgres:YourSecureRDSPassword@your-rds-endpoint.c123456.ap-south-1.rds.amazonaws.com:5432/apnagreenbasket_prod?sslmode=verify-full
TEST_DATABASE_URL=postgresql+asyncpg://postgres:YourSecureRDSPassword@your-rds-endpoint.c123456.ap-south-1.rds.amazonaws.com:5432/apnagreenbasket_test?sslmode=verify-full
DB_CA_CERT_PATH=/app/certs/rds-ca-bundle.pem

# ---- Redis (Containerized in Docker Compose) ----
REDIS_URL=redis://agb-redis:6379/0

# ---- Auth / JWT ----
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_a_random_64_character_hex_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Production Superadmin Initial Setup ----
SUPERADMIN_EMAIL=official@apnagreenbasket.com
SUPERADMIN_PASSWORD=ChangeMeToAStrongPassword123!

# ---- Alerts & Notifications (Email, WhatsApp, SMS) ----
# Resend Email Service (Password Reset OTPs & Notifications)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=ApnaGreen Basket <noreply@apnagreenbasket.com>

# Twilio (WhatsApp & SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Meta WhatsApp Cloud API (Alternative)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

# Indian SMS Gateways (Fast2SMS / MSG91)
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ---- Razorpay (Live or Test Gateway) ----
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Cloudinary Cloud Object Storage ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively: CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ---- AWS S3 Database Backups (7-Day Automated Retention) ----
S3_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_BUCKET_NAME=apnagreenbasket-backups
S3_REGION=ap-south-1

# ---- Performance & Concurrency ----
GUNICORN_WORKERS=2
DASHBOARD_RESET_TIME=00:00

# ---- Runtime Mode ----
# "cloud" = deployed cloud server (sync endpoints mounted)
# "local" = desktop terminal local backend (sync endpoints NOT mounted)
RUNTIME_MODE=cloud
CLOUD_BACKEND_URL=https://api.apnagreenbasket.com
LOCAL_OUTLET_ID=
FRONTEND_URL=https://app.apnagreenbasket.com

# ---- Frontend Build Variable ----
NEXT_PUBLIC_API_URL=https://api.apnagreenbasket.com

